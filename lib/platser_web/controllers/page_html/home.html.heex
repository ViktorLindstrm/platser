<Layouts.flash_group flash={@flash} />

<div class="min-h-screen flex flex-col bg-base-100">
  <%!-- Navigation --%>
  <header class="sticky top-0 z-30 bg-base-100/80 backdrop-blur-md border-b border-base-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
      <div class="flex items-center gap-2 font-bold text-base-content">
        <.icon name="hero-map-pin" class="w-5 h-5 text-primary" />
        <span class="text-base">Platser</span>
      </div>
      <div class="flex items-center gap-3">
        <Layouts.theme_toggle />
        <.link
          href={~p"/sign-in"}
          class="text-sm font-medium text-base-content/70 hover:text-base-content transition-colors px-3 py-1.5 rounded-lg hover:bg-base-200"
        >
          Sign in
        </.link>
        <.link
          href={~p"/register"}
          id="nav-get-started"
          class="text-sm font-semibold px-4 py-1.5 rounded-lg bg-primary text-primary-content hover:brightness-110 transition-all"
        >
          Get started
        </.link>
      </div>
    </div>
  </header>

  <%!-- Hero --%>
  <main class="flex-1">
    <section class="relative overflow-hidden">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-8">
          <.icon name="hero-map-pin" class="w-4 h-4" />
          <span>Collaborative maps for small groups</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-base-content text-balance leading-tight">
          Everyone can see the map.<br />
          <span class="text-primary">Everyone can contribute.</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-base-content/60 max-w-2xl mx-auto text-balance">
          Create a shared map for your hiking trip, festival, or city adventure. Invite friends with a 6-character code and explore together — in real time.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <.link
            href={~p"/register"}
            id="cta-get-started"
            class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-primary text-primary-content font-semibold text-base hover:brightness-110 active:scale-95 transition-all shadow-lg shadow-primary/20"
          >
            Get started — it's free <.icon name="hero-arrow-right" class="w-5 h-5" />
          </.link>
          <.link
            href={~p"/sign-in"}
            id="cta-sign-in"
            class="inline-flex items-center gap-2 px-8 py-3 rounded-xl border border-base-300 text-base-content font-semibold text-base hover:bg-base-200 active:scale-95 transition-all"
          >
            Sign in
          </.link>
        </div>
      </div>
    </section>

    <%!-- Feature highlights --%>
    <section class="border-t border-base-200 bg-base-200/40">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 mb-4">
              <.icon name="hero-map" class="w-6 h-6 text-primary" />
            </div>
            <h3 class="font-semibold text-base-content mb-2">Live map</h3>
            <p class="text-sm text-base-content/60">
              WebGL vector map with live member positions, points of interest, and named regions — all in your browser.
            </p>
          </div>
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 mb-4">
              <.icon name="hero-map-pin" class="w-6 h-6 text-primary" />
            </div>
            <h3 class="font-semibold text-base-content mb-2">Points of Interest</h3>
            <p class="text-sm text-base-content/60">
              Mark meeting spots, campsites, and anything worth sharing. Keep it private or publish to the group.
            </p>
          </div>
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 mb-4">
              <.icon name="hero-ticket" class="w-6 h-6 text-primary" />
            </div>
            <h3 class="font-semibold text-base-content mb-2">Join by code</h3>
            <p class="text-sm text-base-content/60">
              Invite friends with a simple 6-character code. No email required. One tap and they're in.
            </p>
          </div>
        </div>
      </div>
    </section>

    <%!-- Join by code --%>
    <section class="border-t border-base-200">
      <div class="max-w-md mx-auto px-4 sm:px-6 py-16 text-center">
        <h2 class="text-xl font-bold text-base-content mb-2">Already have an invite?</h2>
        <p class="text-base-content/60 mb-8 text-sm">
          Enter your 6-character event code to find your group's map.
        </p>
        <form action={~p"/join"} method="get" id="join-code-form" class="flex gap-3">
          <input
            type="text"
            name="code"
            id="join-code-input"
            placeholder="ABCDEF"
            maxlength="6"
            autocomplete="off"
            class="flex-1 px-4 py-3 rounded-xl border border-base-300 bg-base-100 font-mono text-lg text-center font-bold tracking-widest uppercase text-base-content placeholder:text-base-content/30 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all"
          />
          <button
            type="submit"
            id="join-code-submit"
            class="px-6 py-3 rounded-xl bg-primary text-primary-content font-semibold hover:brightness-110 active:scale-95 transition-all whitespace-nowrap"
          >
            Join
          </button>
        </form>
      </div>
    </section>
  </main>

  <%!-- Footer --%>
  <footer class="border-t border-base-200 py-8">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between">
      <div class="flex items-center gap-2 text-sm text-base-content/40">
        <.icon name="hero-map-pin" class="w-4 h-4" />
        <span>Platser</span>
      </div>
    </div>
  </footer>
</div>
